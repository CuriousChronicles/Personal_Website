# Copy to .env on the Pi and fill in. Never commit the real .env.
API_URL=https://jaytipattni.com
PI_TOKEN=same-value-as-PI_TOKEN-in-vercel
# "onboard" uses the green activity LED; a number uses an external LED on that GPIO pin.
LED_PIN=onboard
POLL_SECONDS=10
# I2C address of the SSD1306 OLED (i2cdetect -y 1 shows it), or "off" for no screen.
OLED_ADDRESS=0x3C
# Blank the screen this long after the last message so the pixels don't burn in.
OLED_TIMEOUT_SECONDS=300
